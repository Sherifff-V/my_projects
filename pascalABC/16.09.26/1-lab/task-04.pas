var n := readinteger('Введите число n:');
var ans := 0;
var chislo: integer;

loop n do
begin
  chislo := readinteger('Введите числа');
  assert(chislo in 0..9);
  ans := (ans * 10) + chislo;
  end;
println('Ответ:', ans)



