##
var x := readreal('Введите x:');
var n := readinteger('Введите n:');
assert(n > 0);
assert(abs(x) < 1);
var sum := 0.0;
var el := x;

for var i := 1 to n do
  begin
  sum += el / i;
  el := -1 * el * x
  end;
 
print($'Сумма ряда: {sum}, Логарифм: {ln(1 + x)}')


